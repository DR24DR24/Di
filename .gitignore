# ==============================================================================
# .gitignore для проекта Di et al. (2025) Transfer Learning (Python / PyTorch)
# ==============================================================================

# --- Байткод и кэш Python ---
__pycache__/
*.py[cod]
*$py.class
*.so

# --- Виртуальные окружения ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Логи и временные файлы ---
*.log
*.tmp
*.temp
tmp/
temp/

# --- Данные и датасеты (CIFAR-10, ImageNet и т.д.) ---
data/
datasets/
cifar-10-batches-py/
*.tar.gz
*.tar
*.zip
*.gz

# --- Веса моделей, чекпоинты и дампы признаков ---
checkpoints/
saved_models/
weights/
*.pt
*.pth
*.ckpt
*.onnx
*.bin
*.h5
*.npy
*.npz
*.pkl
*.pickle

# --- Эксперименты, логирование и трекинг (TensorBoard, WandB) ---
runs/
wandb/
.wandb/
lightning_logs/

# --- Тестирование и покрытие кода ---
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml

# --- Jupyter Ноутбуки ---
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- Сборка и дистрибутивы Python ---
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --- Настройки IDE и редакторов ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Системные файлы ОС ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Переменные окружения и секреты ---
.env
.env.*
!.env.example
